# Copy this file to .env and fill in real values.
# The system runs without any API key (fallback heuristics kick in),
# but real LLM generation and NL-to-SQL translation require one.
# If both are set, Anthropic is used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_CHAT_MODEL=gpt-4o-mini
